NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=

# Optional Gemini Model Override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated fallback models tried only after retries on primary return 503/429
# GEMINI_FALLBACK_MODELS=
# Optional legacy / pro tier overrides
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_PRO_MODEL=gemini-3.8-flash

# Optional Android APK Download URL (PWABuilder / GitHub Releases)
NEXT_PUBLIC_ANDROID_APK_URL=
