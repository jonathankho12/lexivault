{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lexivault",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "lexivault.my.id",
      "custom_domain": true
    },
    {
      "pattern": "www.lexivault.my.id",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
